{
  "name": "fascinate-note",
  "productName": "Fascinate Note",
  "version": "1.2.0",
  "description": "Feel the idea before you write it.",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "start": "cross-env NODE_ENV=development node dev.js",
    "dev:renderer": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "collab:server": "cross-env HOST=localhost PORT=1234 npx y-websocket",
    "build:renderer": "vite build",
    "build": "cross-env NODE_ENV=production npm run build:renderer && electron-builder",
    "build:dir": "cross-env NODE_ENV=production npm run build:renderer && electron-builder --dir",
    "lint": "echo \"No linting configured\""
  },
  "keywords": [],
  "author": {
    "name": "peakk2011",
    "email": "peakk3984@gmail.com"
  },
  "license": "MIT",
  "imports": {
    "#utils-logger": "./src/utils/safeLogger.js",
    "#utils-paths": "./src/utils/paths.js"
  },
  "build": {
    "appId": "com.peakk.fascinatenote",
    "productName": "Fascinate Note",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "dist/renderer/**/*"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "dom-to-image": "^2.6.0",
    "electron-store": "^11.0.2",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@y/websocket-server": "^0.1.1",
    "cross-env": "^10.1.0",
    "electron": "38.4.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.3.0"
  }
}