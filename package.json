{
  "name": "FascinateNote",
  "productName": "Fascinate Note",
  "version": "1.0.0",
  "description": "Feel the idea before you write it.",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "start": "cross-env NODE_ENV=development node dev.js",
    "production": "cross-env NODE_ENV=production node dev.js",
    "dev:renderer": "vite",
    "dev:electron": "electron-forge start",
    "build:renderer": "vite build",
    "package": "electron-forge package",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\""
  },
  "keywords": [],
  "author": {
    "name": "peakk2011",
    "email": "peakk3984@gmail.com"
  },
  "license": "MIT",
  "build": {
    "appId": "com.peakk.fascinatenote",
    "productName": "Fascinate Note",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "dom-to-image": "^2.6.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-deb": "^7.8.3",
    "@electron-forge/maker-rpm": "^7.8.3",
    "@electron-forge/maker-squirrel": "^7.8.3",
    "@electron-forge/maker-zip": "^7.8.3",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.3",
    "@electron-forge/plugin-fuses": "^7.8.3",
    "@electron/fuses": "^1.8.0",
    "cross-env": "^10.1.0",
    "electron": "38.4.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.3.0"
  }
}
