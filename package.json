{
  "name": "fascinate-note",
  "private": true,
  "productName": "Fascinate Note",
  "version": "1.3.0",
  "description": "Feel the idea before you write it.",
  "main": "src/main.js",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "cross-env NODE_ENV=development node dev.js",
    "start:linux": "cross-env NODE_ENV=development ELECTRON_OZONE_PLATFORM_HINT=x11 GDK_BACKEND=x11 node dev.js --ozone-platform=x11",
    "dev:renderer": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev:mobile": "npm --workspace apps/mobile run dev",
    "collab:server": "wrangler dev --local --show-interactive-dev-session=false --config workers/collab/wrangler.jsonc",
    "build:renderer": "vite build",
    "build:web": "cross-env NODE_ENV=production VITE_WEB_BUILD=true vite build",
    "preview:web": "vite preview --outDir ../dist/web",
    "build": "cross-env NODE_ENV=production npm run build:renderer && electron-builder",
    "build:portable": "cross-env NODE_ENV=production npm run build:renderer && electron-builder --win portable",
    "build:dir": "cross-env NODE_ENV=production npm run build:renderer && electron-builder --dir",
    "collab-server": "npm run collab:server",
    "lint": "echo \"No linting configured\"",
    "collab:check": "wrangler deploy --dry-run --config workers/collab/wrangler.jsonc",
    "test:collab": "node --test tests/collab/*.test.js"
  },
  "keywords": [],
  "author": {
    "name": "peakk2011",
    "email": "peakk3984@gmail.com"
  },
  "license": "MIT",
  "imports": {
    "#utils-logger": "./src/utils/safeLogger.js",
    "#utils-paths": "./src/utils/paths.js"
  },
  "build": {
    "appId": "com.peakk.fascinatenote",
    "productName": "Fascinate Note",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main.js",
      "src/initFascinateNotes.js",
      "src/preload.js",
      "src/core/**/*",
      "src/config/**/*",
      "src/utils/paths.js",
      "src/utils/safeLogger.js",
      "src/api/wait.js",
      "assets/icons/**/*",
      "package.json",
      "dist/renderer/**/*"
    ],
    "asar": true,
    "compression": "store",
    "win": {
      "target": "portable",
      "icon": "assets/icons/icon.ico"
    },
    "portable": {
      "artifactName": "Fascinate Note ${version}.${ext}"
    }
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "dom-to-image": "^2.6.0",
    "dompurify": "^3.4.12",
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "electron-store": "^11.0.2",
    "hammerjs": "^2.0.8",
    "partyserver": "^0.5.10",
    "vite": "^7.3.0",
    "wrangler": "4.83.0",
    "ws": "8.20.0",
    "y-partyserver": "^2.2.0",
    "yjs": "^13.6.27"
  }
}
